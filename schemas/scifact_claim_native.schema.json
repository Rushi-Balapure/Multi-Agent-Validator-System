{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs.local/schemas/scifact_claim_native.schema.json",
  "title": "SciFactNativeClaim",
  "type": "object",
  "required": [
    "id",
    "claim",
    "evidence",
    "cited_doc_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "sentences"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "enum": [
                "SUPPORT",
                "CONTRADICT"
              ]
            },
            "sentences": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "cited_doc_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
